# =============================================================================
# Prionex CRM Frontend - Environment Variables
# =============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control
# =============================================================================

# =============================================================================
# API Configuration
# =============================================================================
# Architecture: Microservices behind Kong Gateway
#
# In production/staging: ALL requests go through Kong Gateway (single entry point)
# In development: Can use Kong OR bypass for faster iteration
#
# Kong routes:
#   /api/v1/auth/*    → Auth Service (port 8001)
#   /api/v1/clients/* → Client Service (port 8002)
#   /api/v1/calls/*   → Call Service (port 8005)
#   /ws/calls         → Call Service WebSocket (port 8005)
#   ... etc
# =============================================================================

# Kong Gateway / API Base URL
# Single URL for ALL backend services (Auth, Clients, Calls, SMS, etc.)
# Development: http://localhost:8000 (Kong Gateway - recommended)
# Production: https://api.yourdomain.com (Kong Gateway)
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL for Real-time Call Updates
# Routes through Kong to Call Service
# Development: ws://localhost:8000 (via Kong - recommended)
# Production: wss://api.yourdomain.com (via Kong)
VITE_WS_URL=ws://localhost:8000

# =============================================================================
# Development Only: Direct Service Access (Bypass Kong)
# =============================================================================
# Uncomment these to bypass Kong and connect directly to services
# Useful for faster iteration, debugging, or when Kong is down
#
# VITE_API_BASE_URL=http://localhost:8001  # Direct to Auth Service
# VITE_WS_URL=ws://localhost:8005          # Direct to Call Service WebSocket
#
# WARNING: This does NOT match production architecture!
# =============================================================================

# Application Configuration
VITE_APP_NAME=Prionex CRM
VITE_APP_VERSION=1.0.0

# Environment
# Options: development, staging, production
VITE_ENVIRONMENT=development

# Feature Flags (Optional)
# Enable/disable features
# VITE_ENABLE_DEBUG_MODE=false
# VITE_ENABLE_ANALYTICS=false

# =============================================================================
# Public EasyPay Payment Portal (/pay)
# =============================================================================
# Static portal API key sent as `X-Payment-Portal-Key` when the public payment
# page validates credits / initiates payments against Prionex. Must match the
# payment-service `EASYPAY_PORTAL_API_KEY`. Scoped to a single project; grants
# no read access to CRM data.
VITE_EASYPAY_PORTAL_API_KEY=
