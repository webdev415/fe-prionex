# =============================================================================
# Prionex CRM Frontend - Environment Variables
# =============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control
# =============================================================================

# =============================================================================
# API Configuration
# =============================================================================
# Architecture: Microservices behind Kong Gateway
#
# In production/staging: ALL requests go through Kong Gateway (single entry point)
# In development: Can use Kong OR bypass for faster iteration
#
# Kong routes:
#   /api/v1/auth/*    → Auth Service (port 8001)
#   /api/v1/clients/* → Client Service (port 8002)
#   /api/v1/calls/*   → Call Service (port 8005)
#   /ws/calls         → Call Service WebSocket (port 8005)
#   ... etc
# =============================================================================

# Kong Gateway / API Base URL
# Single URL for ALL backend services (Auth, Clients, Calls, SMS, etc.)
# Development: http://localhost:8000 (Kong Gateway - recommended)
# Production: https://api.yourdomain.com (Kong Gateway)
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL for Real-time Call Updates
# Routes through Kong to Call Service
# Development: ws://localhost:8000 (via Kong - recommended)
# Production: wss://api.yourdomain.com (via Kong)
VITE_WS_URL=ws://localhost:8000

# Operator WebRTC phone (KAN-353) — origin of the hidden softphone the CRM
# embeds as a background iframe. Local development: the phone's Vite dev server
# (the value below). Deployed environments: https://webrtc.crm-prionex.online
# — supplied as a BUILD arg by CD, since Vite inlines it at build time; setting
# it in a server-side .env has no effect on an already-built bundle.
VITE_OPERATOR_PHONE_URL=http://localhost:5173

# =============================================================================
# OpenReplay session replay
# =============================================================================
# The project key is public by nature — it ships inside the bundle every browser
# downloads — so it is a repository VARIABLE in CI, not a secret.
#
# BUILD TIME, like every VITE_* here: Vite inlines these values when the bundle
# is built. Putting them in a server-side .env next to an already-built bundle
# does nothing. Deployed environments get them as build args (see
# .forgejo/workflows/build.yml).
#
# Empty = the tracker does not start. That is a valid state, not a broken setup:
# environments are switched on one at a time by adding their variable.
#
# Left EMPTY here on purpose: this file is copied to .env on a developer machine,
# and local work should not push sessions into a shared project by default. To
# try it locally, paste the DEV project key.
VITE_OPENREPLAY_PROJECT_KEY=
VITE_OPENREPLAY_INGEST_URL=https://openreplay.crm-prionex.online/ingest

# Strict masking: everything on screen becomes asterisks except nodes marked with
# data-openreplay-unmask. Off everywhere today — it also masks page URLs, titles
# and click labels, which leaves a replay you cannot navigate. Only a literal
# true/1 turns it on; anything else (including "True") reads as off.
VITE_OPENREPLAY_PRIVATE_MODE=

# =============================================================================
# Development Only: Direct Service Access (Bypass Kong)
# =============================================================================
# Uncomment these to bypass Kong and connect directly to services
# Useful for faster iteration, debugging, or when Kong is down
#
# VITE_API_BASE_URL=http://localhost:8001  # Direct to Auth Service
# VITE_WS_URL=ws://localhost:8005          # Direct to Call Service WebSocket
#
# WARNING: This does NOT match production architecture!
# =============================================================================

# Application Configuration
VITE_APP_NAME=Prionex CRM
VITE_APP_VERSION=1.0.0

# Environment
# Options: development, staging, production
VITE_ENVIRONMENT=development

# Feature Flags (Optional)
# Enable/disable features
# VITE_ENABLE_DEBUG_MODE=false
# VITE_ENABLE_ANALYTICS=false

# Show Accept / Hold in the incoming-call window. Answering from the CRM works
# by redirecting the caller into an Asterisk dialplan context that not every
# deployment has, and the call-service refuses the request unless its own
# CALL_ANSWER_ENABLED is set. Leave this unset until both that flag and the
# crm-answer / crm-hold contexts exist, or operators get controls that fail;
# with it unset the window tells them to answer on their softphone instead.
VITE_CALL_ANSWER_ENABLED=false
# Credit block in the CRM client card (WS-11, story 14-7). Off by default: the
# block ships before the gateway learns the `clients` route group, and until it
# does the tab would show every operator a "module unavailable" notice.
#
# This file is read by `npm run dev` — locally the value here does switch the
# block. For a BUILT image it does not: the build takes the Forgejo repository
# variable VITE_CREDIT_MODULE_ENABLED_<ENV> as a --build-arg (build.yml), and
# the server's env file reaches nothing.
VITE_CREDIT_MODULE_ENABLED=false

