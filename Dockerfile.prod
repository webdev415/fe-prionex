# Production Dockerfile
# Multi-stage build: build with Node.js, serve with nginx

# Stage 1: Build
#
# 🔒 Pinned by digest, Story 3.6. `node:20-alpine` is a FLOATING tag: it moves
# whenever upstream republishes, so rebuilding the same commit could produce a
# different image through no change of ours. That is the mechanism behind the
# `sha-<12>-<env>` tag silently repointing to a new digest, which Story 3.6 AC2
# is about, and it is the half of that problem fixable without new logic.
#
# Resolved 2026-08-17 from the index digest, so platform selection is unchanged.
# ⚠️ The trade is deliberate: base-image security updates now require an
# explicit bump here instead of arriving silently. Reproducibility is what AC2
# asks for; automatic updates are what it forbids.
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production=false

# Copy source code
COPY . .

# Build arguments for environment variables (Vite requires these at build time)
ARG VITE_API_BASE_URL
ARG VITE_WS_URL
# Assistant report tables (heat map + attention rows). Off unless the build is
# given "true"/"1" — an unset ARG lands as an empty string, i.e. the feature
# stays off. Vite inlines the value at build time, so it MUST arrive here.
ARG VITE_ASSISTANT_REPORT_TABLES_ENABLED
# Origin serving the hidden WebRTC softphone the CRM embeds as a background
# iframe. Vite inlines it at build time, so it has to arrive as a build-arg to
# take effect at all — a runtime env var on the server does nothing.
#
# Optional. Left unset, src/features/operatorPhone/constants.ts resolves the
# origin to "" for a production build (the localhost default is gated on
# import.meta.env.DEV), which suppresses the phone panel and posts the operator
# token nowhere. That is the correct state until a softphone is deployed whose
# VITE_CRM_PARENT_ORIGIN matches the CRM being built here.
ARG VITE_OPERATOR_PHONE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_ASSISTANT_REPORT_TABLES_ENABLED=$VITE_ASSISTANT_REPORT_TABLES_ENABLED
ENV VITE_OPERATOR_PHONE_URL=$VITE_OPERATOR_PHONE_URL

# Say so loudly, but do not fail: a bundle with no phone origin is a valid
# deployment of everything else, and failing here blocks the whole release over
# one dormant feature.
RUN test -n "$VITE_OPERATOR_PHONE_URL" || \
      echo "WARNING: VITE_OPERATOR_PHONE_URL is unset - building without the operator softphone (the phone panel will not mount)"

# Build the application
RUN npm run build

# Stage 2: Production server with nginx
#
# 🔒 Pinned by digest, Story 3.6 — same reasoning as the builder stage above.
FROM nginx:alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

