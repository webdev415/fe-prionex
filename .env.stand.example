# =============================================================================
# Prionex CRM Frontend - STAND Environment Variables (template)
# =============================================================================
# Use with: docker-compose.stand.yml (Story 4.1's parameterized stand file).
# docker-compose.server.yml is the LEGACY stand's file and is untouched by
# this template - do not point this file at it.
#
# Copy this file to the stand's own .env (e.g.
# ~/crm-prionex/fe-prionex-dev/.env) and replace every CHANGE_ME value below.
# Every value here is a placeholder that fails loudly if copied unedited -
# none of them are working values. There is no default for any of these
# variables in docker-compose.stand.yml; a missing value refuses to start
# rather than silently reusing another stand's identity.
# =============================================================================

# -----------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME - the compose project name for this stand.
# Must be unique per stand on the host, e.g. fe-prionex-dev, fe-prionex-preprod.
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=CHANGE_ME

# -----------------------------------------------------------------------------
# CONTAINER_NAME - the container name for this stand.
# Must be unique per stand, and must NEVER be "fe-prionex" - CD.yml:201
# force-removes that exact literal name on every legacy deploy, independent
# of compose project, and would cross into this stand if reused.
# -----------------------------------------------------------------------------
CONTAINER_NAME=CHANGE_ME

# -----------------------------------------------------------------------------
# FRONTEND_PORT - the host-side published port. Container side is fixed at
# 80 and is not configurable here (baked into the image).
#
# Known allocations on s1:
#   legacy stand              : the existing, untouched port (NFR5 - not this
#                                variable's concern, do not reuse it)
#   new DEV stand (Story 4.2) : 8082
#   PRE-PROD (Story 5.2)      : 8083 (amended 2026-08-15; do not use the port
#                                one below 8083 - it is permanently taken on
#                                s1 by docker-proxy for vm-cadvisor, and using
#                                it here would collide with an unrelated
#                                system service, not another stand)
#   PROD (Story 6.10)         : measured on s10, not listed here
#
# Never copy a port from another stand's .env. A wrong value here silently
# reuses that stand's port.
# -----------------------------------------------------------------------------
FRONTEND_PORT=CHANGE_ME

# -----------------------------------------------------------------------------
# DOCKER_IMAGE - the full image reference including tag. There is no default
# and none is coming: ":latest" is CANCELLED (D20 section 4) and is never
# published by the pipeline (build.yml sets PUSH_LATEST=false).
#
# Tag shape is one of:
#   sha-<12hex>-<env>
#   <sanitized-branch>-<env>
# where env is one of: dev, preprod, prod.
#
# Example shape only, not a working value:
#   git.crm-prionex.com/crm/fe-prionex:sha-0123456789ab-dev
# -----------------------------------------------------------------------------
DOCKER_IMAGE=CHANGE_ME

# -----------------------------------------------------------------------------
# FRONTEND_NETWORK - the pre-existing external network this stand attaches
# to. There is no default and one is not possible: a wrong value here
# attaches the stand to the wrong backend SILENTLY (nginx uses lazy DNS
# resolution for the Kong upstream, so the container starts and reports
# healthy even when it cannot reach the right backend, or any backend).
#
# The network must already exist (created by the corresponding api-prionex
# stack) before this stand is brought up. This compose file never creates it.
#
# api-prionex network names, by stand:
#   crm-dev-network      - new DEV stand
#   crm-preprod-network   - PRE-PROD stand
#   crm-prod-network      - PROD stand
#   crm-network           - legacy stand only; do not attach a new stand to
#                            this network, that silently reattaches it to the
#                            legacy backend
# -----------------------------------------------------------------------------
FRONTEND_NETWORK=CHANGE_ME
