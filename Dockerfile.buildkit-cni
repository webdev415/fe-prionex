# Epic 3 retro action item A1 (2026-08-18) — PRODUCTION infrastructure
# image. Not an application image; this is what `build.yml`'s builder runs
# AS, to give every Dockerfile `RUN` step (in `Dockerfile.prod`, `npm ci`
# and `npm run build` included) its own CNI-managed network namespace,
# closing the residual gap D22 named and accepted: OpenBao
# (172.20.0.5:8200) was reachable from every RUN step under the
# `network=fe-prionex-build` bridge alone, because NAT provides address
# translation, not access control.
#
# ── History, so the next reader does not re-derive it ───────────────────
# D22 measured the stock `moby/buildkit:buildx-stable-1` image ships no CNI
# at all (17.08). A probe branch (`probe/a1-cni-netns-isolation`, kept for
# review evidence, deleted after this merges) built and proved this exact
# file end to end: local validation first (docker/buildx v0.35.0), then
# run 739 on the real host (isolation matrix green on the first real
# dispatch; a SEPARATE bug — step order, not this file — sank the cache
# check that run), then run 741 (full matrix green, including the cache
# check after the ordering bug was fixed). See
# [D26](../../docs/migration-decisions.md#d26) for the full account.
#
# Two things measured along the way that are easy to get wrong again:
#   - `docker/setup-buildx-action`'s `buildkitd-flags` input does NOT work
#     on this buildkitd build (v0.32.2) — flags are correctly split into
#     argv but `--oci-cni-config-path` is read as an empty string
#     regardless of what is passed. `build.yml` supplies this image's CNI
#     config via `buildkitd-config-inline` (a TOML config) instead, which
#     does not have this problem. Do not "simplify" that back to flags.
#   - `docker/login-action` (registry auth) MUST run BEFORE
#     `docker/setup-buildx-action` in any workflow that references this
#     image via `driver-opts: image=` — builder creation PULLS this image
#     from OUR OWN private registry, and an unauthenticated pull of a
#     private image fails the whole builder-creation step before any build
#     runs. This sank run 739's cache-check job; `build.yml`'s own step
#     order carries a comment pointing back here for the same reason.
FROM moby/buildkit:buildx-stable-1

# ⚠️ Pinned by tag only, not by digest+checksum — no way to fetch or verify
# a published sha256 for this release from any session that has built this
# so far. Whoever bumps CNI_PLUGINS_VERSION should sanity-check the release
# still looks legitimate (github.com/containernetworking/plugins/releases)
# before trusting an unattended pull of it into infrastructure sharing a
# host with another tenant's production.
ARG CNI_PLUGINS_VERSION=v1.5.1

RUN apk add --no-cache curl tar iptables \
    && mkdir -p /opt/cni/bin \
    && curl -fsSL -o /tmp/cni-plugins.tgz \
       "https://github.com/containernetworking/plugins/releases/download/${CNI_PLUGINS_VERSION}/cni-plugins-linux-amd64-${CNI_PLUGINS_VERSION}.tgz" \
    && tar -C /opt/cni/bin -xzf /tmp/cni-plugins.tgz \
    && rm -f /tmp/cni-plugins.tgz \
    && apk del curl tar
# 🔴 `iptables` stays installed (not `apk del`ed) — the entrypoint wrapper
# below needs it at container START, not just at image build time. Checked
# directly, not assumed: `apk del curl tar` does NOT remove the base
# image's CA bundle (`/etc/ssl/certs/ca-certificates.crt` is a file baked
# into the base image, not an apk package) — a real hypothesis raised while
# diagnosing run 739's failure, and disproven before it cost a run.

# Sandbox network for RUN steps only, separate from whatever network the
# OUTER buildkitd container itself is on (`network=fe-prionex-build`, set
# in `build.yml`'s `driver-opts:`, unchanged by this file). `ipMasq: true`
# NATs this bridge's traffic out so RUN steps keep outbound internet access
# (`npm ci` needs it, and run 741 proved it survives this whole setup).
#
# 🚨 MUST be named `*.conflist`, not `*.json` — measured: buildkit's CNI
# provider picks single-plugin vs multi-plugin ("conflist") JSON schema BY
# FILE EXTENSION. `cni.json` (buildx's own `--help` text names this as the
# documented default path, followed literally in an earlier draft of this
# file) produced `buildkitd: error parsing configuration: missing 'type'`
# — it was trying to parse a conflist body as a single-plugin config.
#
# Subnet chosen to avoid Docker's own default pools (172.17-31.0.0/16) and
# this project's control-plane range (172.20.0.0/16, per D22) — reasoned,
# not measured against every possible collision. No collision surfaced
# across runs 739/741 on the real host.
RUN mkdir -p /etc/buildkit && echo '{"cniVersion":"0.4.0","name":"buildkit-runc-sandbox","plugins":[{"type":"bridge","bridge":"bk-cni0","isGateway":true,"ipMasq":true,"hairpinMode":true,"ipam":{"type":"host-local","subnet":"10.99.0.0/24","routes":[{"dst":"0.0.0.0/0"}]}},{"type":"loopback"}]}' > /etc/buildkit/cni.conflist

# ── The narrow deny rule closing D22's residual gap ──────────────────────
# One FORWARD rule: sandbox subnet -> the control-plane range OpenBao and
# the Forgejo services live on (172.20.0.0/16, per D22's own measurement of
# OpenBao at 172.20.0.5). Nothing else is touched — outbound-to-internet
# traffic is unaffected (destination never matches this rule), and this
# does not change how the OUTER container's own traffic is routed, only
# what the CNI-sandboxed RUN steps can reach via the bridge this image
# adds. `--privileged` (already required for the CNI bridge/veth creation
# itself) covers the NET_ADMIN this needs; no additional capability
# requested.
#
# ✅ VERIFIED on the real host, run 741, not just locally: OpenBao
# unreachable from a RUN step, public internet still reachable, registry
# cache still exportable/importable through this exact builder. See D26.
RUN printf '#!/bin/sh\nset -e\niptables -I FORWARD -s 10.99.0.0/24 -d 172.20.0.0/16 -j DROP\nexec buildkitd "$@"\n' > /usr/local/bin/entrypoint-with-firewall.sh \
    && chmod +x /usr/local/bin/entrypoint-with-firewall.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-with-firewall.sh"]
