# Sanitised template of /opt/forgejo-runner-fe-prionex/.env on s1.
# Real values live only on the host — never commit the actual .env.
# RUNNER_REGISTRATION_TOKEN in particular is a live credential; on the host
# it is a leftover from initial registration and is NOT consumed for
# auto-registration by this image (see docker-compose.yml's comment on the
# `runner`/`runner2` services' environment block) — registration is always
# the explicit `forgejo-runner register` step (docs/runners/README.md).

# Pinned runner image — see D8 (docs/migration-decisions.md#d8) for why a
# floating tag is not used.
RUNNER_IMAGE=code.forgejo.org/forgejo/runner:13.0.0

FORGEJO_INSTANCE_URL=https://git.crm-prionex.com

# Runner 1's name (runner 2's is hardcoded in docker-compose.yml directly —
# GITEA_RUNNER_NAME=s1-fe-prionex-2 — since only one compose project exists).
RUNNER_NAME=s1-fe-prionex-1

# Real value lives only in /opt/forgejo-runner-fe-prionex/.env on s1. Not
# consumed automatically (see above) — kept only because it is harmless once
# .runner exists. Get a fresh one from
# GET /repos/CRM/fe-prionex/actions/runners/registration-token if ever needed.
RUNNER_REGISTRATION_TOKEN=<placeholder — real value on s1 only>

# Dedicated system user (uid/gid 1502 on s1, `forgejo-runner-fe-prionex`),
# shared by both the runner and runner2 services — see docker-compose.yml's
# comment on why sharing it is safe.
RUNNER_UID=1502
RUNNER_GID=1502

# Runner 1's data directory. Runner 2's (RUNNER_DATA_DIR_2) defaults to
# ./data/runner-2 in docker-compose.yml and does not need a .env entry.
RUNNER_DATA_DIR=/opt/forgejo-runner-fe-prionex/data/runner

# Optional overrides, both default sanely in docker-compose.yml if unset:
# RUNNER_CPU_LIMIT=2
# RUNNER_MEMORY_LIMIT=2g
