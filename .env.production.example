# =============================================================================
# Prionex CRM Frontend - PRODUCTION SERVER Environment Variables
# =============================================================================
# Place this file as .env on the prod server: ~/crm-prionex/fe-prionex/.env
# Usage: docker compose -f docker-compose.server.yml --env-file .env up -d
#
# NOTE: VITE_* vars are baked at build time by the CD pipeline.
# This .env is only for Docker Compose runtime configuration.
#
# ⚠️ THIS FILE DESCRIBES THE LEGACY STAND, which is still live and stays
# untouched (NFR5). It is NOT the template for a new stand.
# For a new stand use .env.stand.example with docker-compose.stand.yml
# (Story 4.1) - the port and image below belong to the legacy stand and would
# collide if reused.
# =============================================================================

# Docker image (CD pipeline sets this, fallback to latest)
DOCKER_IMAGE=ghcr.io/crm-prionex/fe-prionex:main

# Frontend port on host
FRONTEND_PORT=8080

# Show Accept / Hold in the incoming-call window. Answering from the CRM works
# by redirecting the caller into an Asterisk dialplan context that not every
# deployment has, and the call-service refuses the request unless its own
# CALL_ANSWER_ENABLED is set. Leave this unset until both that flag and the
# crm-answer / crm-hold contexts exist, or operators get controls that fail;
# with it unset the window tells them to answer on their softphone instead.
VITE_CALL_ANSWER_ENABLED=false
