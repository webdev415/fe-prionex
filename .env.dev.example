# =============================================================================
# Prionex CRM Frontend - DEV SERVER Environment Variables
# =============================================================================
# Place this file as .env on the dev server: ~/crm-prionex/fe-prionex/.env
# Usage: docker compose -f docker-compose.server.yml --env-file .env up -d
#
# NOTE: VITE_* vars are baked at build time by the CD pipeline.
# This .env is only for Docker Compose runtime configuration.
#
# ⚠️ THIS FILE DESCRIBES THE LEGACY STAND, which is still live and stays
# untouched (NFR5). It is NOT the template for the new DEV stand.
# For a new stand use .env.stand.example with docker-compose.stand.yml
# (Story 4.1) - the port and image below belong to the legacy stand and would
# collide if reused.
# =============================================================================

# Docker image (CD pipeline sets this, fallback to latest)
DOCKER_IMAGE=ghcr.io/crm-prionex/fe-prionex:development

# Frontend port on host
FRONTEND_PORT=8080

# Show Accept / Hold in the incoming-call window. Answering from the CRM works
# by redirecting the caller into an Asterisk dialplan context that not every
# deployment has, and the call-service refuses the request unless its own
# CALL_ANSWER_ENABLED is set. Leave this unset until both that flag and the
# crm-answer / crm-hold contexts exist, or operators get controls that fail;
# with it unset the window tells them to answer on their softphone instead.
VITE_CALL_ANSWER_ENABLED=false
# Credit block in the CRM client card (WS-11, story 14-7). Off by default: the
# block ships before the gateway learns the `clients` route group, and until it
# does the tab would show every operator a "module unavailable" notice.
#
# 🔴 THIS LINE DOES NOT SWITCH THE BLOCK ON. Vite inlines VITE_* at BUILD time,
# and the image serves an already-built dist — a value in the server's env file
# reaches nothing. The build reads the Forgejo repository variable
# VITE_CREDIT_MODULE_ENABLED_<ENV> and passes it as --build-arg (build.yml, step
# "Select the credit-block flag for this environment"). To turn the block on for
# an environment, set that variable and build the commit again.
VITE_CREDIT_MODULE_ENABLED=false
# HUB chat settings in the role forms (board #1621, story 4) instead of the
# «HUB chat role» field. Off by default until HUB applies the chat set
# (HUB_CHAT_SET_MODE=on, story 13).
#
# 🔴 THIS LINE DOES NOT SWITCH IT ON for a built image: the build reads the
# Forgejo repository variable VITE_ROLE_CHAT_SETTINGS_ENABLED_<ENV> and passes it
# as --build-arg (build.yml, step "Select the role chat settings flag for this
# environment"). To turn it on for an environment, set that variable and build
# the commit again.
VITE_ROLE_CHAT_SETTINGS_ENABLED=false

